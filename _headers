# the speech files are versioned by folder (speech/1), so they never change: a year
/speech/*
  Cache-Control: public, max-age=31536000, immutable
# stockfish 10 in webassembly, versioned by folder (engine/10) like the speech files: a year
/engine/*
  Cache-Control: public, max-age=31536000, immutable
# the pieces and 3d set change rarely: a week, then a check
/pieces/*
  Cache-Control: public, max-age=604800
/models/*
  Cache-Control: public, max-age=604800
# self-hosted fonts, versioned by folder (fonts/1): a year
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# cross-origin isolation, so phonon's threaded wasm can use every core; credentialless keeps no-cors images working
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
